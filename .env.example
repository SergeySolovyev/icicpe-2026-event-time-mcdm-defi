# Aave V3 subgraph (used by AaveV3RatesLoader in fractal-defi)
THE_GRAPH_API_KEY=

# Dune Analytics (gas prices + fallback rate data)
DUNE_API_KEY=

# fractal-defi cache root (set so all loaders cache to the repo)
FRACTAL_DATA_PATH=./data/cached/

# MLflow tracking URI (local Docker stack on port 5500)
MLFLOW_TRACKING_URI=http://localhost:5500
