# Aave V3 endpoint is Aave's own gateway (api.v3.aave.com/graphql) — no key needed.
# THE_GRAPH_API_KEY is REQUIRED only for the Compound V3 Messari subgraph,
# which lives on the decentralized network (hosted service deprecated 2024).
THE_GRAPH_API_KEY=

# Dune Analytics (gas prices + fallback rate data)
DUNE_API_KEY=

# fractal-defi cache root (set so all loaders cache to the repo)
FRACTAL_DATA_PATH=./data/cached/

# MLflow tracking URI (local Docker stack on port 5500)
MLFLOW_TRACKING_URI=http://localhost:5500
