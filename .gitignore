# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.coverage
htmlcov/
.tox/

# Virtual environments
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# MLflow
mlruns/
mlartifacts/
results/mlflow/

# Data caches (regenerable, large)
data/cached/*.parquet
data/cached/*.csv
data/cached/*.pkl
data/cached/*.json
data/cached/fractal_data/
fractal_data/                    # fractal-defi loader cache when DATA_PATH unset
!data/cached/.gitkeep

# Model weights (large; regenerable from train.py)
forecaster/trained_models/*.onnx
forecaster/trained_models/*.pt
forecaster/trained_models/*.cbm
!forecaster/trained_models/.gitkeep

# Colab upload bundle (regenerable via scripts/prepare_colab_artifacts.py)
predictive-mcdm-defi-artifacts.zip

# Whitepaper build artifacts
whitepaper/*.aux
whitepaper/*.log
whitepaper/*.out
whitepaper/*.bbl
whitepaper/*.blg
whitepaper/*.bcf
whitepaper/*.run.xml
whitepaper/sections/*.aux
whitepaper/*.fdb_latexmk
whitepaper/*.fls
whitepaper/*.synctex.gz

# Defense deck build artifacts (defense.pdf is tracked, like main.pdf)
slides/*.aux
slides/*.log
slides/*.out
slides/*.nav
slides/*.snm
slides/*.toc
slides/*.vrb
slides/*.fdb_latexmk
slides/*.fls
slides/*.synctex.gz

# Secrets
.env
*.key

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/
!.gitkeep
