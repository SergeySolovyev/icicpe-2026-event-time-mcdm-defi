# syntax=docker/dockerfile:1
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=10000 \
    OPENBLAS_NUM_THREADS=1 \
    OMP_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    NUMEXPR_NUM_THREADS=1

WORKDIR /app
COPY requirements-mirage.txt ./requirements-mirage.txt
RUN pip install --no-cache-dir -r requirements-mirage.txt

# Explicit product inputs: no research data, weights, .git, or local secrets.
COPY LICENSE ./LICENSE
COPY mirage/__init__.py mirage/allocator.py mirage/bytecode.py mirage/gate.py mirage/scan.py mirage/server.py mirage/verdict.py ./mirage/
COPY mirage/chain/*.py ./mirage/chain/
COPY mirage/detectors/*.py ./mirage/detectors/
COPY mirage/discovery/*.py ./mirage/discovery/
COPY mirage/vendor/__init__.py ./mirage/vendor/
COPY mirage/vendor/revert_pro/__init__.py mirage/vendor/revert_pro/evm_extractor.py mirage/vendor/revert_pro/LICENSE mirage/vendor/revert_pro/PROVENANCE.md ./mirage/vendor/revert_pro/
COPY mirage/web/index.html mirage/web/app.js mirage/web/style.css ./mirage/web/
COPY mirage/snapshots/demo.json mirage/snapshots/*.json.gz ./mirage/snapshots/
COPY decision/__init__.py decision/base.py decision/t1_threshold.py ./decision/
COPY scripts/mirage_host.py ./mirage_host.py

RUN useradd --create-home --uid 10001 mirage \
    && mkdir -p /app/data/cached/mirage \
    && chown -R mirage:mirage /app/data
USER mirage
# Offline replay fails the build if installed decoder/numeric packages disagree
# with the frozen evidence. This performs no Graph/RPC request and opens no port.
RUN python -c "from mirage.server import Application; app = Application(); app.get_report(); app.get_comparison('10000', None); print('Saved evidence and allocator replay validated')"
EXPOSE 10000
CMD ["python", "/app/mirage_host.py"]
